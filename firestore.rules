rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- kdo je kdo ----------

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    // Školní účet: e-mail @ghb.cz. Heslový účet musí mít ověřený e-mail;
    // Microsoft (fáze 2) e-mail ověřený nevrací, tam stačí provider (aplikace je single-tenant).
    function isSchool() {
      return signedIn()
        && email().matches('.*@ghb[.]cz$')
        && (provider() == 'microsoft.com'
            || provider() == 'google.com'
            || (provider() == 'password' && request.auth.token.email_verified == true));
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/allowedUsers/$(email()));
    }

    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/allowedUsers/$(email()));
    }

    // Superadmin: pevně daný účet s právy na vše. Nedá se odebrat ani změnit z aplikace,
    // platí i bez záznamu v allowedUsers (měnit jde jen tady v pravidlech).
    function superAdminEmail() {
      return 'garrukaf@gmail.com';
    }

    function isSuperAdmin() {
      return signedIn() && email() == superAdminEmail() && request.auth.token.email_verified == true;
    }

    function isTeacher() {
      return isSuperAdmin() || (isStaff() && staffDoc().data.role in ['teacher', 'admin', 'superadmin']);
    }

    function isAdmin() {
      return isSuperAdmin() || (isStaff() && staffDoc().data.role == 'admin');
    }

    function isAllowed() {
      return isSchool() || isStaff() || isSuperAdmin();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- whitelist učitelů a výjimek ----------

    match /allowedUsers/{mail} {
      allow get: if signedIn() && mail == email();
      allow list: if isTeacher();
      // superadmina nikdo z aplikace nezmění ani neodebere a další superadmin vzniknout nemůže
      allow create, update: if isAdmin() && mail != superAdminEmail()
        && request.resource.data.role in ['student', 'teacher', 'admin'];
      allow delete: if isAdmin() && mail != superAdminEmail();
    }

    // ---------- uživatelé ----------

    match /users/{uid} {
      allow read: if isAllowed() && (isOwner(uid) || isTeacher());
      allow create: if isAllowed() && isOwner(uid)
        && request.resource.data.email == email();
      allow update: if isAllowed() && isOwner(uid)
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'track', 'gradYear', 'layout', 'lastActiveAt']);
    }

    // ---------- postup v kurzu ----------

    match /progress/{uid} {
      allow read: if isAllowed() && (isOwner(uid) || isTeacher());
      allow create: if isAllowed() && isOwner(uid) && progressValid(null);
      allow update: if isAllowed() && isOwner(uid) && progressValid(resource.data);
    }

    function progressValid(prev) {
      let d = request.resource.data;
      return d.courseCompletion is number && d.courseCompletion >= 0 && d.courseCompletion <= 100
        && d.bestCpm is number && d.bestCpm >= 0 && d.bestCpm <= 900
        && d.bestNetCpm is number && d.bestNetCpm >= 0 && d.bestNetCpm <= 900
        && d.totalRuns is int && d.totalRuns >= 0
        && d.unlockedChapter is int && d.unlockedChapter >= 1 && d.unlockedChapter <= 22
        && (prev == null || (
             d.courseCompletion >= prev.courseCompletion
             && d.totalRuns == prev.totalRuns + 1
             && d.bestCpm >= prev.bestCpm
             && d.totalMinutes >= prev.totalMinutes
        ));
    }

    // ---------- běhy (jen zápis nového, nikdy změna) ----------

    match /runs/{runId} {
      allow read: if isAllowed() && (isOwner(resource.data.uid) || isTeacher());
      allow create: if isAllowed() && isOwner(request.resource.data.uid) && runValid();
      // učitel může běh anulovat (podezření)
      allow update: if isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'suspicious']);
      allow delete: if false;
    }

    function runValid() {
      let d = request.resource.data;
      return d.levelId is string
        && d.durationMs is number && d.durationMs >= 3000 && d.durationMs <= 3600000
        && d.cpm is number && d.cpm >= 0 && d.cpm <= 900
        && d.netCpm is number && d.netCpm >= 0 && d.netCpm <= d.cpm
        && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100
        && d.score is number && d.score >= 0 && d.score <= 100000
        && d.stars is int && d.stars >= 0 && d.stars <= 3
        && d.correct is int && d.correct >= 0
        && d.errors is int && d.errors >= 0
        // hrubé úhozy/min musí odpovídat počtu správných znaků a délce (±5 %)
        && d.cpm <= (d.correct * 60000 / d.durationMs) * 1.05 + 1
        && d.keystrokes is list && d.keystrokes.size() <= 8000;
    }

    // ---------- statistiky pro žebříčky ----------

    match /stats/{statId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isOwner(request.resource.data.uid)
        && statId == request.resource.data.uid + '_' + request.resource.data.schoolYear
        && statsValid(null);
      allow update: if isAllowed() && isOwner(resource.data.uid) && statsValid(resource.data);
    }

    function statsValid(prev) {
      let d = request.resource.data;
      return d.bestCpm is number && d.bestCpm >= 0 && d.bestCpm <= 900
        && d.bestNetCpm is number && d.bestNetCpm >= 0 && d.bestNetCpm <= 900
        && d.courseCompletion is number && d.courseCompletion >= 0 && d.courseCompletion <= 100
        && d.totalScore is number && d.totalScore >= 0
        && d.runs is int && d.runs >= 1
        && (prev == null || (
             d.uid == prev.uid
             && d.schoolYear == prev.schoolYear
             && d.runs == prev.runs + 1
             && d.bestCpm >= prev.bestCpm
             && d.courseCompletion >= prev.courseCompletion
        ));
    }

    // ---------- známky ----------

    match /grades/{gradeId} {
      // id = uid_rok; get funguje i pro neexistující dokument (resource je tam null)
      allow get: if isAllowed() && (gradeId == request.auth.uid + '_' + gradeId.split('_')[1] || isTeacher());
      allow list: if isTeacher();
      // student žádá; pokud dokument existuje, jen když není zamčený
      allow create: if isAllowed() && isOwner(request.resource.data.uid)
        && request.resource.data.status == 'requested'
        && request.resource.data.locked == false
        && request.resource.data.gradeOffered >= 1 && request.resource.data.gradeOffered <= 5;
      allow update: if
        // student obnoví zamítnutou / nezamčenou žádost
        (isAllowed() && isOwner(resource.data.uid) && resource.data.locked == false
          && request.resource.data.status == 'requested' && request.resource.data.locked == false)
        // učitel zapíše nebo zamítne
        || (isTeacher() && resource.data.locked == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'recordedBy', 'recordedAt', 'subject', 'locked']));
      allow delete: if false;
    }

    // ---------- nápady na vylepšení (/napady) ----------
    // Navrhovat, hlasovat a komentovat může každý přihlášený; stav, řešitele a odkaz na PR mění učitel.

    match /counters/{name} {
      allow read: if isAllowed();
      allow create: if isAllowed() && name == 'suggestions'
        && request.resource.data.keys().hasOnly(['lastNumber'])
        && request.resource.data.lastNumber == 1;
      allow update: if isAllowed() && name == 'suggestions'
        && request.resource.data.keys().hasOnly(['lastNumber'])
        && request.resource.data.lastNumber == resource.data.lastNumber + 1;
    }

    function suggestionStatuses() {
      return ['new', 'accepted', 'in_progress', 'done', 'rejected'];
    }

    function suggestionTextValid(d) {
      return d.title is string && d.title.size() >= 3 && d.title.size() <= 120
        && d.body is string && d.body.size() <= 4000
        && d.category in ['napad', 'chyba', 'hra', 'obsah', 'vzhled'];
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // přidá / odebere právě svůj hlas a čítač posune o 1
    function voteValid() {
      let before = resource.data.voters.toSet();
      let after = request.resource.data.voters.toSet();
      let me = [request.auth.uid].toSet();
      return changed().hasOnly(['voters', 'votes'])
        && ((after.difference(before) == me && before.difference(after).size() == 0
              && request.resource.data.votes == resource.data.votes + 1)
          || (before.difference(after) == me && after.difference(before).size() == 0
              && request.resource.data.votes == resource.data.votes - 1));
    }

    match /suggestions/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['number', 'uid', 'authorName', 'classId', 'title', 'body',
             'category', 'status', 'voters', 'votes', 'commentCount', 'assignee', 'link', 'createdAt', 'updatedAt'])
        && suggestionTextValid(request.resource.data)
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
        && request.resource.data.status == 'new'
        && request.resource.data.voters.size() == 0 && request.resource.data.votes == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.assignee == null && request.resource.data.link == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.number == getAfter(/databases/$(database)/documents/counters/suggestions).data.lastNumber;
      allow update: if isAllowed() && (
        voteValid()
        // komentář přidán / smazán (batch spolu s dokumentem v podkolekci)
        || (changed().hasOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.commentCount + 1
                || request.resource.data.commentCount == resource.data.commentCount - 1))
        // autor upraví text, dokud je návrh nový
        || (isOwner(resource.data.uid) && resource.data.status == 'new'
            && changed().hasOnly(['title', 'body', 'category', 'updatedAt'])
            && suggestionTextValid(request.resource.data))
        // tým: stav, řešitel, odkaz (a případně oprava textu)
        || (isTeacher()
            && changed().hasOnly(['status', 'assignee', 'link', 'title', 'body', 'category', 'updatedAt'])
            && request.resource.data.status in suggestionStatuses()
            && suggestionTextValid(request.resource.data)
            && (request.resource.data.assignee == null
                || (request.resource.data.assignee is string && request.resource.data.assignee.size() <= 80))
            && (request.resource.data.link == null
                || (request.resource.data.link is string && request.resource.data.link.matches('https://.{1,400}'))))
      );
      allow delete: if isTeacher()
        || (isAllowed() && isOwner(resource.data.uid) && resource.data.status == 'new' && resource.data.commentCount == 0);

      match /comments/{commentId} {
        allow read: if isAllowed();
        allow create: if isAllowed() && isOwner(request.resource.data.uid)
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'staff', 'body', 'createdAt'])
          && request.resource.data.staff == isTeacher()
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isTeacher() || (isAllowed() && isOwner(resource.data.uid));
      }
    }

    // ---------- konfigurace ----------

    match /config/{docId} {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }
  }
}
